{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YTNH",
  "version": "11.4.1",
  "identifier": "com.localnotestodos.desktop",
  "build": { "frontendDist": "../web", "features": ["inline-images-preview"] },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "YTNH", "width": 1400, "height": 900, "minWidth": 800, "minHeight": 550, "dragDropEnabled": false }],
    "security": { "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'" }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "windows": { "nsis": { "installMode": "currentUser" }, "webviewInstallMode": { "type": "downloadBootstrapper" } },
    "macOS": { "minimumSystemVersion": "11.0", "signingIdentity": "-" }
  }
}
